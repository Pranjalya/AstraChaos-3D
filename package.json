{
  "name": "astrachaos-3d",
  "version": "0.1.0",
  "description": "High-performance interactive 3D simulation of the chaotic Three-Body Problem demonstrating the Butterfly Effect using Next.js, React Three Fiber, and a Rust WebAssembly RK4 physics engine.",
  "author": "Pranjalya Tiwari <https://github.com/Pranjalya>",
  "homepage": "https://pranjalya.github.io/AstraChaos-3D",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranjalya/AstraChaos-3D.git"
  },
  "bugs": {
    "url": "https://github.com/Pranjalya/AstraChaos-3D/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:wasm && next build",
    "start": "next start",
    "lint": "next lint",
    "build:wasm": "cd wasm-physics && wasm-pack build --target web --out-dir ../public/wasm"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}